# ==========================================
# Git Ignore Rules - Campus Surveillance System
# ==========================================

# ------------------------------------------
# Non-Application Folders & Documentation
# ------------------------------------------
Thesis/
train/
FYP Ideas/
Training weights and graphs/
Database/
notebooks/
Expalination.txt
details_for_training.txt

# ------------------------------------------
# Python & Virtual Environments
# ------------------------------------------
.venv/
venv/
env/
ENV/
*.py[cod]
*$py.class
__pycache__/
*.so
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ------------------------------------------
# Node.js & Frontend Build Outputs
# ------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ------------------------------------------
# SQLite Databases & WAL/SHM Runtime Files
# ------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
data/*.db
data/*.db-shm
data/*.db-wal

# ------------------------------------------
# Dynamic Runtime Uploads & Media Recordings
# ------------------------------------------
data/Evidence/*
!data/Evidence/.gitkeep
data/challans/*.pdf
!data/challans/.gitkeep
*.mp4
*.avi
*.mov
*.mkv
*.webm

# ------------------------------------------
# Large Datasets, Backups & Checkpoints
# ------------------------------------------
*.zip
*.tar.gz
*.rar
FYP.zip
FYPmerge.zip.zip
yolo_models/*.zip
yolo_models/FYPmerge/
yolo_models/New folder/
yolo_models/yolo_models/
yolo_models/1best.pt
yolo_models/1last.pt
yolo_models/2last.pt
yolo_models/epoch*.pt

# ------------------------------------------
# OS & IDE Tooling Files
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
.env
.env.local
.vscode/
.idea/
*.swp
*.swo
